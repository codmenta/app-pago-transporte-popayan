{
  "expo": {
    "name": "PopaPay",
    "slug": "app-pago-transporte-popayan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F6FB",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#1E40AF"
      }
    },
    "web": {
      "bundler": "metro",
      "name": "PopaPay",
      "shortName": "PopaPay",
      "description": "Paga tu pasaje de bus en Popayán desde el celular",
      "favicon": "./assets/images/favicon.png",
      "themeColor": "#1E40AF",
      "backgroundColor": "#F4F6FB"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "PopaPay usa la camara para escanear el codigo QR del bus y pagar tu pasaje."
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F4F6FB"
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ]
  }
}
