{
  "expo": {
    "name": "app-pago-transporte-popayan",
    "slug": "app-pago-transporte-popayan",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "PopaPay usa la camara para escanear el codigo QR del bus y pagar tu pasaje."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser"
    ]
  }
}
